      "eventEnd": "2026-12-05T19:00:00Z",
      "treasures": [
        { "id": "pirate-shop-access", "name": "Pirate Shop Access", "oneIn": 137500, "featured": true, "weekly": false }
      ],
      "treasureHours": [
        {
          "id": "2026-11-07-night",
          "start": "2026-11-08T02:00:00Z",
          "end": "2026-11-08T04:00:00Z",
          "multipliers": { "pirate-shop-access": 2.0 }
        },
        {
          "id": "2026-11-14-afternoon",
          "start": "2026-11-14T19:00:00Z",
          "end": "2026-11-14T21:00:00Z",
          "multipliers": { "pirate-shop-access": 1.5 },
          "expected": true
        }
      ]
    },
    "wednesday-reset": {
